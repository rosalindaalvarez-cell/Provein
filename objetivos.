        const AreaList = ({ data, onAreaSelect }) => {
            const areaNames = Object.keys(data);

            const getLatestScore = (collaboratorData) => {
                const data = collaboratorData.data;
                const quarters = Object.keys(data);
                
                const sortedQuarters = quarters.sort((a, b) => {
                    const getQuarterNumber = (q) => {
                         const match = q.match(/\\d+/);
                         return match ? parseInt(match[0], 10) : 0;
                    }
                    const getYear = (q) => {
                         const match = q.match(/\\d{4}/);
                         return match ? parseInt(match[0], 10) : 0;
                    }
                    
                    const yearA = getYear(a);
                    const yearB = getYear(b);
                    if(yearA !== yearB) return yearB - yearA;

                    const qA = getQuarterNumber(a);
                    const qB = getQuarterNumber(b);
                    return qB - qA;
                });
                
                for (const q of sortedQuarters) {
                    if (data[q].calificacion_total > 0) {
                        return data[q];
                    }
                }
                
                const firstQuarterKey = sortedQuarters[0] || Object.keys(data)[0];
                return data[firstQuarterKey] || { calificacion_total: 0 };
            };

            const calculateAreaAverage = (area) => {
                const collaborators = Object.values(area.collaborators);
                if (collaborators.length === 0) return 0;

                const totalScore = collaborators.reduce((sum, collaborator) => {
                    const latestData = getLatestScore(collaborator);
                    return sum + (latestData?.calificacion_total || 0);
                }, 0);

                return totalScore / collaborators.length;
            };

            return (
                <div className="mb-8">
                    <h2 className="text-xl font-bold text-gray-700 mb-4">Resumen por Área</h2>
                    <div id="resumen-areas" className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        {areaNames.map(name => {
                            const area = data[name];
                            const averageScore = calculateAreaAverage(area);
                            const collaboratorCount = Object.keys(area.collaborators).length;

                            let scoreColor = 'text-gray-900';
                            let borderColor = 'border-gray-300';

                            if (averageScore > 1.0) {
                                scoreColor = 'text-blue-600';
                                borderColor = 'border-blue-500';
                            } else if (averageScore >= 0.8) {
                                scoreColor = 'text-green-600';
                                borderColor = 'border-green-500';
                            } else if (averageScore > 0) {
                                scoreColor = 'text-yellow-600';
                                borderColor = 'border-yellow-500';
                            } else {
                                scoreColor = 'text-red-600';
                                borderColor = 'border-red-500';
                            }

                            return (
                                <div key={name} onClick={() => onAreaSelect(name)} className={`bg-white p-4 rounded-xl shadow border-l-4 ${borderColor} transform transition duration-300 hover:scale-[1.03] hover:shadow-lg cursor-pointer flex items-start space-x-4`}>
