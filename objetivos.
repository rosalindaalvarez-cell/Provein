                    ...objectiveData,
                    id: maxId + 1,
                    resultado: '',
                    valor_100: valor100,
                    valor_extra_pct: objectiveData.valor_pct * 1.2,
                    valor_monto_total: valor100 * 1.2,
                    calificacion_pct: 0,
                    calificacion_monto: 0,
                };

                quarter.objetivos.push(newObjective);
                setData(newData);
            };
            
            const handleObjectiveUpdate = (
                collaboratorName,
                quarterName,
                objectiveId,
                newPctValue
            ) => {
                if (!selectedArea) return;

                const newData = JSON.parse(JSON.stringify(data));
                
                const areaData = newData[selectedArea];
                const collaborator = areaData.collaborators[collaboratorName];
                const quarterData = collaborator.data[quarterName];
                const objective = quarterData.objetivos.find(o => o.id === objectiveId);

                if (objective) {
                    objective.calificacion_pct = newPctValue;
                    if (newPctValue !== null) {
                        const baseAmount = objective.valor_100;
                        const basePct = objective.valor_pct;
                        objective.calificacion_monto = basePct > 0 ? (newPctValue / basePct) * baseAmount : 0;
                    } else {
                        objective.calificacion_monto = 0;
                    }
                }

                quarterData.calificacion_total = quarterData.objetivos.reduce(
                    (sum, obj) => sum + (obj.calificacion_pct || 0), 0
                );
                quarterData.monto_calificado = quarterData.objetivos.reduce(
                    (sum, obj) => sum + (obj.calificacion_monto || 0), 0
                );
                
                setData(newData);
            };

            const handleResultUpdate = (
                collaboratorName,
                quarterName,
                objectiveId,
                newResultText
            ) => {
                if (!selectedArea) return;

                const newData = JSON.parse(JSON.stringify(data));
                
                const areaData = newData[selectedArea];
                const collaborator = areaData.collaborators[collaboratorName];
                const quarterData = collaborator.data[quarterName];
                const objective = quarterData.objetivos.find(o => o.id === objectiveId);

                if (objective) {
                    objective.resultado = newResultText;
                }
                
                setData(newData);
            };
            
            const clearSelection = () => {
                setSelectedArea(null);
                setSelectedCollaborator(null);
                setSelectedQuarter(null);
            }

            const currentAreaData = useMemo(() => {
                if (!selectedArea) return null;
                return data[selectedArea];
            }, [selectedArea, data]);

            const currentCollaboratorData = useMemo(() => {
                if (!currentAreaData || !selectedCollaborator) return null;
                return currentAreaData.collaborators[selectedCollaborator];
            }, [currentAreaData, selectedCollaborator]);

            const currentQuarterData = useMemo(() => {
                if (!currentCollaboratorData || !selectedQuarter) return null;
                return currentCollaboratorData.data[selectedQuarter];
            }, [currentCollaboratorData, selectedQuarter]);

            return (
                <div className="p-4 sm:p-8">
                    <div className="max-w-screen-2xl mx-auto bg-white shadow-xl rounded-2xl p-6 md:p-10">
                        <header className="mb-8 border-b pb-4">
                            <h1 className="text-3xl font-extrabold text-gray-900 mb-1">
                                <span className="text-indigo-600">Gestión de Objetivos</span> por Área
                            </h1>
                            <p className="text-gray-500">Datos consolidados de rendimiento por área, colaborador y período.</p>
                        </header>
                        
                        {!selectedArea ? (
                            <>
                                <BonusSummary data={data} onCollaboratorSelect={handleCollaboratorSelectFromSummary} onOpenAddQuarterModal={() => setIsAddQuarterModalOpen(true)} />
                                <AreaList data={data} onAreaSelect={handleAreaSelect} />
                            </>
                        ) : (
                            <section>
                                 <div className="flex justify-between items-center mb-4 border-t pt-4">
                                    <h2 className="text-2xl font-bold text-gray-800">
                                        Área: <span className="text-indigo-600">{selectedArea}</span>
                                    </h2>
                                    <button 
                                        onClick={clearSelection}
                                        className="px-4 py-2 text-sm font-medium text-indigo-600 bg-indigo-100 rounded-lg hover:bg-indigo-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors"
                                    >
                                        ← Volver a Áreas
                                    </button>
                                </div>

                                <FilterControls
                                    area={currentAreaData}
                                    selectedCollaborator={selectedCollaborator}
                                    selectedQuarter={selectedQuarter}
                                    onCollaboratorChange={handleCollaboratorChange}
                                    onQuarterChange={handleQuarterChange}
                                />
                                
                                <ResultsPanel 
                                    collaborator={currentCollaboratorData}
                                    quarterData={currentQuarterData}
                                    collaboratorName={selectedCollaborator}
                                    selectedQuarter={selectedQuarter}
                                    onObjectiveUpdate={handleObjectiveUpdate}
                                    onResultUpdate={handleResultUpdate}
                                    onOpenAddObjectiveModal={() => setIsAddObjectiveModalOpen(true)}
                                />
                                
                                {currentQuarterData && <OverallProgress quarterData={currentQuarterData} />}
                            </section>
                        )}
                        
                        <AddQuarterModal 
                            isOpen={isAddQuarterModalOpen} 
                            onClose={() => setIsAddQuarterModalOpen(false)}
                            onSave={handleAddNewQuarter}
                            nextQuarterName={nextQuarterName}
                        />
                        
                        <AddObjectiveModal
                            isOpen={isAddObjectiveModalOpen}
                            onClose={() => setIsAddObjectiveModalOpen(false)}
                            onSave={handleAddNewObjective}
                            quarterData={currentQuarterData}
                        />

                    </div>
                </div>
            );
        };
        // --- FIN: App.tsx ---


        // --- INICIO: index.tsx (Render) ---
        const rootElement = document.getElementById('root');
        if (!rootElement) {
          throw new Error("No se pudo encontrar el elemento raíz para montar la aplicación.");
        }

        const root = ReactDOM.createRoot(rootElement);
        root.render(
          <React.StrictMode>
            <App />
          </React.StrictMode>
        );
        // --- FIN: index.tsx ---

    </script>
</body>
</html>
